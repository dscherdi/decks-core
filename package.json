{
  "name": "@decks/core",
  "version": "2.0.0",
  "description": "Core scheduling, parsing, and data logic for Decks spaced repetition",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean",
    "check": "tsc --noEmit -p tsconfig.json",
    "build:watch": "tsup src/index.ts --format esm --dts --out-dir dist --watch",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "benchmark": "node benchmark/build.mjs && node benchmark/.bundle/cli.cjs",
    "benchmark:smoke": "node benchmark/build.mjs smoke && node benchmark/.bundle/smoke.cjs",
    "benchmark:spec-check": "node benchmark/build.mjs spec-check && node benchmark/.bundle/specCheck.cjs",
    "benchmark:compare": "node benchmark/build.mjs compare && node benchmark/.bundle/compareOptimizers.cjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "^9.39.2",
    "@types/jest": "^29.5.14",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "fsrs-rs-nodejs": "^0.9.0",
    "globals": "^15.15.0",
    "hyparquet": "^1.25.6",
    "hyparquet-compressors": "^1.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "js-yaml": "^5.1.0"
  }
}
